<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pretty Configuration Manager" Height="740" Width="1100"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

  <Window.Resources>
    <!-- ═══ Color Palette (Light theme defaults — overridden by Apply-Theme at startup) ═══ -->
    <SolidColorBrush x:Key="BgBrush" Color="#D6E6F5"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#E4EEF8"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#CDDFF0"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#A8C4DD"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5A8FC4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D78B0"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#C2D6EA"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A2333"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3D5872"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <!-- ═══ Button Style ═══ -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Secondary button style (surface-colored) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ ListBox Style ═══ -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ ListBoxItem Style ═══ -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd"
                    Background="Transparent"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ TabControl Style ═══ -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <!-- Tab strip with bottom border -->
              <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,0">
                <TabPanel IsItemsHost="True" Margin="4,0,0,0"/>
              </Border>
              <!-- Content area -->
              <Border Grid.Row="1" Background="Transparent" Margin="0,8,0,0">
                <ContentPresenter ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ TabItem Style ═══ -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Padding="16,10" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,4,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ TextBox Style ═══ -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Tag" Value=""/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
              <Grid Margin="{TemplateBinding Padding}">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              Margin="0" Padding="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Placeholder"
                           Text="{TemplateBinding Tag}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontStyle="Italic" FontSize="12"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Opacity="0.6"
                           Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value=""/>
                  <Condition Property="IsFocused" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ ComboBox Style ═══ -->
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6"
                      SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="v" FontSize="10"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
              </Border>
              <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="Transparent" BorderThickness="0" Opacity="0"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True" Placement="Bottom"
                     MinWidth="{TemplateBinding ActualWidth}">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" CornerRadius="6"
                        MaxHeight="200">
                  <ScrollViewer>
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ ComboBoxItem Style ═══ -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ ScrollBar Style ═══ -->
    <!-- Thumb (the draggable part) -->
    <Style x:Key="ThemedScrollThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBd" CornerRadius="4"
                    Background="{DynamicResource BorderBrush}" Opacity="0.5"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="ThumbBd" Property="Opacity" Value="0.7"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                <Setter TargetName="ThumbBd" Property="Opacity" Value="0.9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Vertical ScrollBar -->
    <Style TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource ThemedScrollThumb}" Margin="1,0"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ThemedScrollThumb}" Margin="0,1"/>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ═══ NavButton Style (top-right navigation bar) ═══ -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SurfaceHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══ NavMenuItemButton Style (dropdown menu items) ═══ -->
    <Style x:Key="NavMenuItemButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid Margin="16,8,16,10" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="4"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══ Header bar with navigation ═══ -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: App title -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Pretty Configuration Manager" FontSize="17" FontWeight="SemiBold" FontStyle="Italic" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="  &#xB7;  " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        <TextBlock Name="LnkReadme" Text="(view Readme)" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Cursor="Hand">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>

      <!-- Right: Navigation buttons -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Name="NavBtnOutlook"  Content="Outlook"  Style="{StaticResource NavButton}"/>
        <Button Name="NavBtnSkype"    Content="Skype"    Style="{StaticResource NavButton}" Visibility="Collapsed"/>
        <Button Name="NavBtnMUD"      Content="MUD"      Style="{StaticResource NavButton}" Visibility="Collapsed"/>
        <Button Name="NavBtnExtras"   Content="Extras"   Style="{StaticResource NavButton}" Visibility="Collapsed"/>
        <Button Name="NavBtnSettings" Content="&#x2699;" Style="{StaticResource NavButton}" FontSize="18" Padding="10,4" ToolTip="Settings"/>
      </StackPanel>

      <!-- Outlook dropdown menu -->
      <Popup Name="PopOutlookMenu" PlacementTarget="{Binding ElementName=NavBtnOutlook}"
             Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
             HorizontalOffset="-45">
        <Border Name="PopOutlookMenuOuter" Background="Transparent" Padding="0,2,0,0">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1.5" CornerRadius="6" Padding="4">
            <StackPanel MinWidth="140">
              <Button Name="NavMenuSignatures"  Content="Signatures"  Style="{StaticResource NavMenuItemButton}"/>
              <Button Name="NavMenuPermissions" Content="Permissions" Style="{StaticResource NavMenuItemButton}"/>
              <Button Name="NavMenuDev"         Content="Dev"         Style="{StaticResource NavMenuItemButton}" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </Border>
      </Popup>

      <!-- Settings dropdown panel -->
      <Popup Name="PopSettingsMenu" PlacementTarget="{Binding ElementName=NavBtnSettings}"
             Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
             HorizontalOffset="-280">
        <Border Name="PopSettingsMenuOuter" Background="Transparent" Padding="0,2,0,0">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1.5" CornerRadius="8" Padding="16,12" MinWidth="340">
            <StackPanel>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="TxtLblColourTheme" Grid.Column="0" Text="Colour theme"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <ListBox Name="LbThemeSelector" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding"                    Value="0"/>
                      <Setter Property="Margin"                     Value="0,0,6,0"/>
                      <Setter Property="Background"                 Value="Transparent"/>
                      <Setter Property="BorderThickness"            Value="2"/>
                      <Setter Property="BorderBrush"                Value="Transparent"/>
                      <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
                      <Setter Property="IsTabStop"                  Value="False"/>
                      <Setter Property="HorizontalContentAlignment" Value="Center"/>
                      <Setter Property="VerticalContentAlignment"   Value="Center"/>
                      <Setter Property="Cursor"                     Value="Hand"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Outer" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="2" Background="Transparent">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                              </Trigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBoxItem Tag="Light"  ToolTip="Light">
                    <Border Width="26" Height="26" CornerRadius="6" Background="#D6E6F5"/>
                  </ListBoxItem>
                  <ListBoxItem Tag="Dark"   ToolTip="Dark">
                    <Border Width="26" Height="26" CornerRadius="6" Background="#7C6FE0"/>
                  </ListBoxItem>
                  <ListBoxItem Tag="Green"  ToolTip="Green">
                    <Border Width="26" Height="26" CornerRadius="6" Background="#4E8A6E"/>
                  </ListBoxItem>
                  <ListBoxItem Tag="Maroon" ToolTip="Maroon" Margin="0">
                    <Border Width="26" Height="26" CornerRadius="6" Background="#8A4E5E"/>
                  </ListBoxItem>
                </ListBox>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="TxtLblLanguage" Grid.Column="0" Text="Language"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <ComboBox Name="CbLanguageSelector" Grid.Column="2"
                          Background="{DynamicResource SurfaceBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" Padding="8,4" MinWidth="120">
                  <ComboBoxItem Content="English" Tag="en"/>
                  <ComboBoxItem Content="Deutsch" Tag="de"/>
                </ComboBox>
              </Grid>

              <!-- ══ About ══ -->
              <TextBlock Name="BtnAbout" Text="About" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" Margin="0,12,0,0" Cursor="Hand">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

            </StackPanel>
          </Border>
        </Border>
      </Popup>

    </Grid>

    <!-- ═══ Content Area ═══ -->
    <Grid Grid.Row="2">

      <!-- ── Outlook section (Signatures + Permissions, toggled via dropdown) ── -->
      <Grid Name="PanelOutlookContent" Visibility="Visible">

        <!-- ─── Signatures view ─── -->
        <Grid Name="PanelSignaturesView" Visibility="Visible">
          <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <!-- Main content area (left + right boxes) -->
            <RowDefinition Height="*"/>
            <!-- Bottom bar -->
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- ══ MAIN CONTENT: Left (mailboxes) + Right (preview) in matched boxes ══ -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT BOX: Mailbox / Signature list ── -->
            <Border Grid.Column="0" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                    Background="Transparent" Padding="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mailbox + signature list -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Name="PanelInboxList"/>
                </ScrollViewer>

                <!-- Action buttons centered at bottom -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Name="BtnRefreshMailboxes" Content="&#x21BB;"
                          Style="{DynamicResource SecondaryButton}"
                          Width="28" Height="28" Padding="0" FontSize="14"
                          ToolTip="Refresh mailboxes" Margin="0,0,6,0"/>
                  <Button Name="BtnNewSignature"    Content="New"
                          Style="{DynamicResource SecondaryButton}" Padding="14,5" FontSize="11" Margin="0,0,6,0"/>
                  <Button Name="BtnRenameSignature" Content="Rename"
                          Style="{DynamicResource SecondaryButton}" Padding="14,5" FontSize="11" Margin="0,0,6,0" Tag="Rename"/>
                  <Button Name="BtnDeleteSignature" Content="Delete"
                          Style="{DynamicResource SecondaryButton}" Padding="14,5" FontSize="11" Tag="Delete"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- ── RIGHT BOX: Preview ── -->
            <Border Grid.Column="2" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                    Background="Transparent" Padding="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview area -->
                <Border Grid.Row="0" Name="PanelPreview" CornerRadius="8" ClipToBounds="True"
                        Background="{DynamicResource BgBrush}">
                  <Grid>
                    <WebBrowser Name="PreviewBrowser" Visibility="Collapsed"/>
                    <!-- Empty state — hidden once a signature is loaded -->
                    <TextBlock Name="TxtPreviewEmptyHint"
                               Text="Select a signature on the left to preview it here."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="24" Opacity="0.55"
                               IsHitTestVisible="False"/>
                  </Grid>
                </Border>

                <!-- Bottom row: Reload + Edit centered together; Info at far right independently -->
                <Grid Grid.Row="2">
                  <!-- Buttons centered in the full row width -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Name="BtnReloadPreview" Content="&#x21BB;"
                            Style="{DynamicResource SecondaryButton}"
                            Width="28" Height="28" Padding="0" FontSize="14"
                            ToolTip="Reload preview" Margin="0,0,6,0"
                            Visibility="Collapsed"/>
                    <Button Name="BtnEditSignature" Content="Edit in Outlook"
                            Style="{DynamicResource SecondaryButton}" Padding="10,5" FontSize="11"
                            Visibility="Collapsed"/>
                  </StackPanel>
                  <!-- Info text floats at the right edge, doesn't affect button centering -->
                  <TextBlock Name="TxtSignatureInfo" Text=""
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <!-- ══ BOTTOM BAR: Selected signature + mailbox pills (click to toggle assign) ══ -->
          <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="8"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                  Padding="12,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Name="TxtSelectedSig" Text="(select a signature above)"
                         FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="200"/>

              <!-- Mailbox pills (hover to assign/unassign the selected signature) -->
              <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <StackPanel Name="PanelCopyTargets" Orientation="Horizontal" VerticalAlignment="Center"/>
              </ScrollViewer>
            </Grid>
          </Border>


            </Grid>
        </Grid>

        <!-- ─── Permissions view ─── -->
        <Grid Name="PanelPermissionsView" Visibility="Collapsed">
          <TabControl Name="TabsPermInner" Margin="0,4,0,0">

          <!-- ══ Easy sub-tab (default) ══ -->
          <TabItem Header="Easy" Name="TabPermEasy">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Permissions Overview (left) ── -->
                <StackPanel Grid.Column="0">
                  <TextBlock Name="TxtLblPermOverview" Text="PERMISSIONS OVERVIEW"
                             FontWeight="SemiBold" FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,8"/>
                  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                          Padding="16,12">
                    <StackPanel>
                      <Border Name="PanelPermReport" Visibility="Visible"
                              Background="{DynamicResource BgBrush}" CornerRadius="6"
                              Padding="12,10" MaxHeight="400">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <StackPanel Name="PanelPermReportContent"/>
                        </ScrollViewer>
                      </Border>
                      <Button Name="BtnRefreshEasyMailboxes" Content="Refresh mailboxes"
                              Margin="0,10,0,0" HorizontalAlignment="Stretch"
                              Style="{DynamicResource SecondaryButton}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- ── Quick Setup Wizard (right) ── -->
                <StackPanel Grid.Column="2">
                  <TextBlock Name="TxtLblPermWizard" Text="QUICK SETUP"
                             FontWeight="SemiBold" FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,8"/>
                  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                          Padding="16,12">
                  <StackPanel>
                    <TextBlock Name="TxtWizardDesc"
                               Text="Set up folder permissions step by step."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Step 1: Choose mailbox -->
                    <StackPanel Name="WizStep1">
                      <TextBlock Name="TxtWizStep1" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Text="Step 1: Choose a mailbox you want to edit" Margin="0,0,0,8"/>
                      <ListBox Name="LbWizMailboxes" MaxHeight="200">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,2,0,2">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                         Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding SmtpAddress}" FontSize="11"
                                         Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Name="TxtWizStatus1" FontSize="12" Margin="0,6,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                      <Button Name="BtnWizNext1" Content="Next" Margin="0,10,0,0"
                              HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Step 2: Choose users -->
                    <StackPanel Name="WizStep2" Visibility="Collapsed">
                      <TextBlock Name="TxtWizStep2" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Text="Step 2: Choose users you want to give permissions to" Margin="0,0,0,8"/>
                      <StackPanel>
                        <TextBox Name="TxtWizUserSearch" Tag="Search by name or email..."
                                 ToolTip="Search Active Directory or type an email address directly"/>
                        <Border Name="BorderWizAdResults" Visibility="Collapsed" Margin="0,2,0,0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" CornerRadius="4">
                          <ListBox Name="LbWizAdResults" MaxHeight="200" BorderThickness="0"
                                   Background="{DynamicResource SurfaceBrush}"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                              <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                              </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Margin="0,1">
                                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"
                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                  <TextBlock Text="{Binding Mail}" FontSize="11"
                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Border>
                      </StackPanel>
                      <TextBlock Name="TxtWizSelectedLabel" Text="" FontSize="11" Margin="0,8,0,4"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <StackPanel Name="PanelWizSelectedUsers"/>
                      <TextBlock Name="TxtWizStatus2" FontSize="12" Margin="0,6,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Name="BtnWizBack2" Content="Back" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Name="BtnWizNext2" Content="Next"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Step 3: Choose folders -->
                    <StackPanel Name="WizStep3" Visibility="Collapsed">
                      <TextBlock Name="TxtWizStep3" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Text="Step 3: Select folders you want to share" Margin="0,0,0,8"/>
                      <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="PanelWizFolders"/>
                      </ScrollViewer>
                      <TextBlock Name="TxtWizStatus3" FontSize="12" Margin="0,6,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Name="BtnWizBack3" Content="Back" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Name="BtnWizNext3" Content="Next"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Step 4: Choose permission level -->
                    <StackPanel Name="WizStep4" Visibility="Collapsed">
                      <TextBlock Name="TxtWizStep4" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Text="Step 4: What should they be able to do?" Margin="0,0,0,8"/>
                      <StackPanel Name="PanelWizPermLevels"/>
                      <TextBlock Name="TxtWizStatus4" FontSize="12" Margin="0,6,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Name="BtnWizBack4" Content="Back" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Name="BtnWizNext4" Content="Next"/>
                      </StackPanel>
                    </StackPanel>

                    <!-- Step 5: Summary + Execute -->
                    <StackPanel Name="WizStep5" Visibility="Collapsed">
                      <TextBlock Name="TxtWizStep5" FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Text="Step 5: Review and apply" Margin="0,0,0,8"/>
                      <Border Background="{DynamicResource BgBrush}" CornerRadius="6" Padding="12,10">
                        <StackPanel Name="PanelWizSummary"/>
                      </Border>
                      <TextBlock Name="TxtWizResult" Margin="0,8,0,0" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Name="BtnWizBack5" Content="Back" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Name="BtnWizApply" Content="Apply permissions" Margin="0,0,8,0"/>
                        <Button Name="BtnWizReset" Content="Start over" Style="{DynamicResource SecondaryButton}"/>
                      </StackPanel>
                    </StackPanel>

                  </StackPanel>
                </Border>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <!-- ══ Advanced sub-tab ══ -->
          <TabItem Header="Advanced" Name="TabPermAdvanced">
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- ── Column 0: Mailbox list (no filter) ── -->
              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="10"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="TxtLblMailboxes" Text="MAILBOXES" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,0"/>

                <Grid Grid.Row="2">
                  <ListBox Name="LbMailboxes">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Margin"  Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                     Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding SmtpAddress}" FontSize="11"
                                     Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <!-- Empty state overlay — hidden by Ui.ps1 when items exist -->
                  <TextBlock Name="TxtMailboxEmptyHint"
                             Text="Open Outlook, then click Refresh mailboxes."
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12" FontStyle="Italic"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="12" Opacity="0.7"
                             IsHitTestVisible="False"/>
                </Grid>

                <Button Grid.Row="4" Name="BtnRefreshPerm" Content="Refresh mailboxes"
                        HorizontalAlignment="Stretch" Style="{DynamicResource SecondaryButton}"/>
              </Grid>

              <!-- ── Column 2: Folder list ── -->
              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="TxtLblFolders" Text="FOLDERS" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,0"/>

                <Grid Grid.Row="2">
                  <ListBox Name="LbFolders">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin"  Value="0"/>
                        <Setter Property="MinHeight" Value="20"/>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentPad}">
                          <TextBlock Text="{Binding Icon}" FontSize="12"
                                     FontFamily="Segoe UI Symbol"
                                     Margin="0,0,5,0" Width="16"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     VerticalAlignment="Center" TextAlignment="Center"/>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <!-- Empty state overlay — hidden when folders are loaded -->
                  <TextBlock Name="TxtFoldersHint"
                             Text="Select a mailbox to see its folders"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12" FontStyle="Italic"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="12" Opacity="0.7"
                             IsHitTestVisible="False"/>
                </Grid>
              </Grid>

              <!-- ── Column 4: People & permissions ── -->
              <Grid Grid.Column="4" Name="PanelPermRight">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="*" MinHeight="80"/>
                  <RowDefinition Height="10"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="6"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Name="TxtLblWhoHasAccess" Text="PERMISSIONS" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <Grid Grid.Row="2">
                  <DataGrid Name="DgCurrentPerms"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            HeadersVisibility="Column"
                            CanUserReorderColumns="False"
                            CanUserSortColumns="False"
                            CanUserResizeRows="False"
                            SelectionMode="Single"
                            GridLinesVisibility="None"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            RowBackground="{DynamicResource SurfaceBrush}"
                            AlternatingRowBackground="{DynamicResource BgBrush}"
                            HorizontalScrollBarVisibility="Disabled"
                            ColumnHeaderHeight="30">
                    <DataGrid.ColumnHeaderStyle>
                      <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                      </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                      <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                      <Style TargetType="DataGridRow">
                        <Style.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Person or group" Binding="{Binding User}" Width="*"/>
                      <DataGridTextColumn Header="Access level"    Binding="{Binding PermissionLevelName}" Width="180"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <!-- Empty state overlay — hidden when a folder is selected -->
                  <TextBlock Name="TxtFolderHint"
                             Text="Select a folder to see who has access"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12" FontStyle="Italic"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="12" Opacity="0.7"
                             IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Row="4">
                  <TextBox Name="TxtAddUser"
                           Tag="Search by name or email..."
                           ToolTip="Search Active Directory or type an email address directly"/>
                  <Border Name="BorderAdResults" Visibility="Collapsed" Margin="0,2,0,0"
                          Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource AccentBrush}"
                          BorderThickness="1" CornerRadius="4">
                    <ListBox Name="LbAdResults" MaxHeight="200" BorderThickness="0"
                             Background="{DynamicResource SurfaceBrush}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Padding" Value="8,2"/>
                          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,1">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Mail}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                </StackPanel>

                <ComboBox Grid.Row="6" Name="CbPermLevel"
                          Background="{DynamicResource SurfaceBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          Padding="8,6"
                          ToolTip="Choose what this person is allowed to do"/>

                <StackPanel Grid.Row="8" Orientation="Horizontal">
                  <Button Name="BtnSavePerm"   Content="Save"   Margin="0,0,8,0" Width="90"/>
                  <Button Name="BtnRemovePerm" Content="Remove" Width="90"
                          Style="{DynamicResource SecondaryButton}"/>
                </StackPanel>

                <TextBlock Grid.Row="10" Name="TxtPermStatus" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
              </Grid>
            </Grid>
          </TabItem>

          </TabControl>
        </Grid>

        <!-- ─── Dev view (unlocked via dev mode) ─── -->
        <Grid Name="PanelDevView" Visibility="Collapsed" Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Top box spanning full width, takes half the height -->
          <Border Grid.Row="0" CornerRadius="8"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                  Background="Transparent" Padding="10">
            <TextBlock Name="TxtDevProfileGen" Text="Profile generator"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="15" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6"/>
          </Border>

          <!-- Bottom row: two boxes side by side -->
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                    Background="Transparent" Padding="10">
              <TextBlock Name="TxtDevAdressbook" Text="Refresh Outlook adressbook"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="15" FontStyle="Italic"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.6"/>
            </Border>

            <Border Grid.Column="2" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                    Background="Transparent" Padding="10">
              <TextBlock Name="TxtDevChangeFont" Text="Outlook change font"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="15" FontStyle="Italic"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.6"/>
            </Border>
          </Grid>
        </Grid>

      </Grid>

      <!-- ── Skype section (two boxes side by side) ── -->
      <Grid Name="PanelSkypeContent" Visibility="Collapsed">
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- LEFT BOX: Clear cache -->
          <Border Grid.Column="0" CornerRadius="8"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                  Background="Transparent" Padding="10">
            <TextBlock Name="TxtSkypeCacheMsg" Text="Clear cache"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="15" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6"/>
          </Border>

          <!-- RIGHT BOX: Profile generator -->
          <Border Grid.Column="2" CornerRadius="8"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                  Background="Transparent" Padding="10">
            <TextBlock Name="TxtSkypeGeneratorMsg" Text="Profile generator"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="15" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6"/>
          </Border>
        </Grid>
      </Grid>

      <!-- ── MUD section ── -->
      <Grid Name="PanelMUDContent" Visibility="Collapsed">
        <TextBlock Name="TxtMUDMsg" Text="Feature not implemented"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="15" FontStyle="Italic"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.6"/>
      </Grid>

      <!-- ── About section ── -->
      <Grid Name="PanelAboutContent" Visibility="Collapsed">
        <TextBlock Text="Inspired by G.Q. and B.B., made by Lucas and Claude."
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <!-- ── Extras section (Konami-unlocked, hidden by default) ── -->
      <Grid Name="PanelExtrasContent" Visibility="Collapsed">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Top bar: Lock button -->
          <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,12">
            <Button Name="BtnLockExtras" Content="&#x1F512;  Lock Extras"
                    Style="{DynamicResource SecondaryButton}" Padding="24,10" FontSize="14"/>
          </StackPanel>

          <!-- Inner TabControl: Utilities | Shennanigans -->
          <TabControl Grid.Row="1" Name="TabsExtrasInner">

            <!-- ── Utilities sub-tab ── -->
            <TabItem Header="Utilities">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <StackPanel Name="PanelUtilities" Orientation="Vertical">

                  <!-- Delete all signatures card -->
                  <Border Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          CornerRadius="6" BorderThickness="1"
                          Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Delete All Signatures"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Permanently removes all local signature files and clears all mailbox signature assignments."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button Grid.Column="1" Name="BtnDeleteAllSigs" Content="Delete All"
                              Width="90" Height="30" Margin="12,0,0,0"
                              VerticalAlignment="Center"/>
                    </Grid>
                  </Border>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ── Shennanigans sub-tab ── -->
            <TabItem Header="Shennanigans">
              <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                  <Button Name="BtnKillAll" Content="&#x1F480;  Kill All"
                          Style="{DynamicResource SecondaryButton}" Padding="10,5" FontSize="11"/>
                </StackPanel>

                <!-- Scrollable list of troll extras -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel Name="PanelExtras" Orientation="Vertical"/>
                </ScrollViewer>
              </Grid>
            </TabItem>

          </TabControl>
        </Grid>
      </Grid>

    </Grid>

    <!-- ═══ Status Bar (always visible) ═══ -->
    <Border Name="StatusBar" Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,4" Margin="0,6,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5">
      <TextBlock Name="TxtStatus" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
    </Border>
  </Grid>
</Window>
